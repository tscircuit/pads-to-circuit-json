{
  "name": "pads-to-circuit-json",
  "version": "0.0.1",
  "description": "Convert PADS PCB files into Circuit JSON with source-linked diagnostics",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "type": "module",
  "files": ["lib"],
  "scripts": {
    "benchmark:ems4": "bun run scripts/benchmark-test-asset.ts ems4-rev2",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "bun test --timeout 60000",
    "test:download-assets": "bun run scripts/download-test-assets.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/pads-to-circuit-json.git"
  },
  "keywords": ["pads", "circuit-json", "pcb", "eda", "tscircuit"],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tscircuit/alphabet": "0.0.25",
    "@tscircuit/circuit-json-util": "0.0.102",
    "@types/bun": "latest",
    "bun-match-svg": "0.0.15",
    "circuit-json-to-connectivity-map": "0.0.25",
    "circuit-to-svg": "0.0.394",
    "schematic-symbols": "0.0.238",
    "sharp": "0.35.3",
    "stack-svgs": "0.0.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "circuit-json": "0.0.485",
    "padsts": "github:tscircuit/padsts#a01e301"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
